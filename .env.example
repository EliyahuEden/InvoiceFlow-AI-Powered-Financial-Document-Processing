# Copy to .env and adjust. Never commit real secrets.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Document bucket encryption at rest: none (local SeaweedFS) | AES256 | aws:kms. Required in production.
S3_SSE=none
S3_KMS_KEY_ID=

# AI provider: offline (default, no external calls) | anthropic | openai (OpenAI-compatible, e.g. Ollama)
LLM_PROVIDER=offline
LLM_MODEL=                  # e.g. gpt-5.4-nano (cheapest that handles extraction); empty = provider default
LLM_REASONING_EFFORT=       # gpt-5 / o-series only: minimal | low (default) | medium | high
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=            # e.g. http://host.docker.internal:11434/v1 for a local Ollama, https://api.groq.com/openai/v1 for Groq
# rules_first (default): rules read every invoice, the LLM only fills open fields | llm_first: every invoice to the LLM
EXTRACTION_MODE=rules_first
LLM_MAX_OUTPUT_TOKENS=8000  # lower (e.g. 3000) for free tiers with a small tokens-per-minute budget
# Optional USD price table for cost estimates: {"model-id": {"input": 3.0, "output": 15.0}}
LLM_PRICING_JSON={}

# Retrieval (local models, downloaded once into the "models" volume)
EMBEDDING_BACKEND=fastembed
RERANKER_BACKEND=fastembed   # set to "none" to skip the 1.1 GB cross-encoder
