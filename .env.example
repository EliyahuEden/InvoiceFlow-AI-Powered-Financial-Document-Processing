# Copy to .env and adjust. Never commit real secrets.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Document bucket encryption at rest: none (local SeaweedFS) | AES256 | aws:kms. Required in production.
S3_SSE=none
S3_KMS_KEY_ID=

# AI provider. Default: Groq (free tier, OpenAI-compatible) with openai/gpt-oss-120b.
# Paste your Groq key (console.groq.com/keys) below. Without a key the app runs fully offline:
# rule-based extraction and extractive answers, no external calls.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Optional paid primary: a key for the official OpenAI API (platform.openai.com), separate from the Groq key above.
# With it, AI runs on OPENAI_PLATFORM_MODEL first and falls back to Groq, then to the offline path.
OPENAI_PLATFORM_API_KEY=
OPENAI_PLATFORM_MODEL=gpt-4.1-mini
AI_PAID_DAILY_TOKEN_BUDGET=300000
RATE_LIMIT_AI_PER_DAY=40
# empty = openai/gpt-oss-120b on Groq (gpt-5.4-nano on api.openai.com)
LLM_MODEL=
# Other options: LLM_PROVIDER=offline | anthropic (ANTHROPIC_API_KEY) | openai with OPENAI_BASE_URL=https://api.openai.com/v1
# for OpenAI, or http://host.docker.internal:11434/v1 for a local Ollama (no key needed).
ANTHROPIC_API_KEY=
# gpt-5 / o-series only: minimal | low (default) | medium | high
LLM_REASONING_EFFORT=
# rules_first (default): rules read every invoice, the LLM only fills open fields | llm_first: every invoice to the LLM
EXTRACTION_MODE=rules_first
# Groq's free tier has a small tokens-per-minute budget; 3000 avoids most rate-limit errors
LLM_MAX_OUTPUT_TOKENS=3000
# Spending guards: model tokens per business per UTC day (then that business runs offline; 0 = unlimited)
# and model-backed requests (policy answers, Copilot, investigations) per user per minute.
AI_DAILY_TOKEN_BUDGET=100000
RATE_LIMIT_AI_PER_MINUTE=20
# Integrations: requests per API key per minute, and for outbound webhooks the seconds to wait for a receiver and
# the attempts (30 s up to 12 h apart) before a delivery is marked failed.
# RATE_LIMIT_API_KEY_PER_MINUTE=600
# WEBHOOK_TIMEOUT_SECONDS=10
# WEBHOOK_MAX_ATTEMPTS=6
# Email (password reset, invitations). Locally, Docker Compose sends to the Mailpit inbox at http://localhost:8025.
# For real delivery, use any SMTP provider (SendGrid, Mailgun, Resend, Gmail, your domain):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=InvoiceFlow <billing@yourcompany.co.il>
# The web app's public address, used in emailed links (https:// in production):
# APP_BASE_URL=http://localhost:3000
# Invoices by email: each business gets its own forwarding address (Settings → Email inbox). Off until a template is set.
# {token} is replaced by the business's secret token. Mail reaches InvoiceFlow by polling a mailbox (IMAP, read by the
# worker) and/or by a signed webhook your mail provider posts to. See docs/deployment.md, "Receive invoices by email".
# Locally, Mailpit only *sends* mail (it has no IMAP), so use the webhook or a throwaway IMAP mailbox.
# INBOUND_ADDRESS_TEMPLATE=invoices+{token}@inbox.example.com
# INBOUND_IMAP_HOST=imap.example.com
# INBOUND_IMAP_PORT=993                  # default: 993 (ssl) or 143 (starttls, none)
# INBOUND_IMAP_SECURITY=ssl              # ssl | starttls | none (none is refused in production)
# INBOUND_IMAP_USERNAME=inbox@example.com
# INBOUND_IMAP_PASSWORD=
# INBOUND_IMAP_FOLDER=INBOX
# INBOUND_IMAP_POLL_SECONDS=60
# INBOUND_IMAP_BATCH=25                  # messages read per poll
# INBOUND_WEBHOOK_SECRET=                # at least 32 characters: `openssl rand -hex 32`. Enables POST /api/inbound/email
# INBOUND_MAX_ATTACHMENTS=10             # files taken from one message
# RATE_LIMIT_INBOUND_PER_HOUR=120        # messages per business per hour (0 = unlimited); more wait for the next poll
# Production secrets (docker-compose.prod.yml refuses to start without them). Generate each password with
# `openssl rand -hex 24` (letters and digits only: they become part of a connection URL).
# POSTGRES_PASSWORD=
# APP_DB_PASSWORD=
# S3_ENDPOINT_URL=            # empty for AWS; your provider's endpoint for R2, B2...
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# S3_SSE=AES256
# Offsite backups: a separate bucket (the backup service uploads every nightly dump there)
# BACKUP_S3_URI=s3://my-backups/invoiceflow
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_REGION=auto
# BACKUP_KEEP_DAYS=14
# Production front door (docker-compose.prod.yml): your domain, its https origin, and the proxies in front of the API.
# SITE_ADDRESS=invoices.example.co.il
# CORS_ORIGINS=["https://invoices.example.co.il"]
# TRUSTED_PROXY_HOPS=1
# Public sign-up: on by default, off by default when ENVIRONMENT=production. Set true or false to override.
# ALLOW_SIGNUP=
# Optional USD price table for cost estimates: {"model-id": {"input": 3.0, "output": 15.0}}
LLM_PRICING_JSON={}

# Retrieval (local models, downloaded once into the "models" volume)
EMBEDDING_BACKEND=fastembed
# set to "none" to skip the 1.1 GB cross-encoder
RERANKER_BACKEND=fastembed
