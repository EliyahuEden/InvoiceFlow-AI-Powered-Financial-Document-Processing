# Copy to .env and adjust. Never commit real secrets.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Document bucket encryption at rest: none (local SeaweedFS) | AES256 | aws:kms. Required in production.
S3_SSE=none
S3_KMS_KEY_ID=

# AI provider. Default: Groq (free tier, OpenAI-compatible) with openai/gpt-oss-120b.
# Paste your Groq key (console.groq.com/keys) below. Without a key the app runs fully offline:
# rule-based extraction and extractive answers, no external calls.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
# empty = openai/gpt-oss-120b on Groq (gpt-5.4-nano on api.openai.com)
LLM_MODEL=
# Other options: LLM_PROVIDER=offline | anthropic (ANTHROPIC_API_KEY) | openai with OPENAI_BASE_URL=https://api.openai.com/v1
# for OpenAI, or http://host.docker.internal:11434/v1 for a local Ollama (no key needed).
ANTHROPIC_API_KEY=
# gpt-5 / o-series only: minimal | low (default) | medium | high
LLM_REASONING_EFFORT=
# rules_first (default): rules read every invoice, the LLM only fills open fields | llm_first: every invoice to the LLM
EXTRACTION_MODE=rules_first
# Groq's free tier has a small tokens-per-minute budget; 3000 avoids most rate-limit errors
LLM_MAX_OUTPUT_TOKENS=3000
# Spending guards: model tokens per business per UTC day (then that business runs offline; 0 = unlimited)
# and model-backed requests (policy answers, Copilot, investigations) per user per minute.
AI_DAILY_TOKEN_BUDGET=100000
RATE_LIMIT_AI_PER_MINUTE=20
# Email (password reset, invitations). Locally, Docker Compose sends to the Mailpit inbox at http://localhost:8025.
# For real delivery, use any SMTP provider (SendGrid, Mailgun, Resend, Gmail, your domain):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=InvoiceFlow <billing@yourcompany.co.il>
# The web app's public address, used in emailed links (https:// in production):
# APP_BASE_URL=http://localhost:3000
# Production front door (docker-compose.prod.yml): your domain, its https origin, and the proxies in front of the API.
# SITE_ADDRESS=invoices.example.co.il
# CORS_ORIGINS=["https://invoices.example.co.il"]
# TRUSTED_PROXY_HOPS=1
# Public sign-up: on by default, off by default when ENVIRONMENT=production. Set true or false to override.
# ALLOW_SIGNUP=
# Optional USD price table for cost estimates: {"model-id": {"input": 3.0, "output": 15.0}}
LLM_PRICING_JSON={}

# Retrieval (local models, downloaded once into the "models" volume)
EMBEDDING_BACKEND=fastembed
# set to "none" to skip the 1.1 GB cross-encoder
RERANKER_BACKEND=fastembed
