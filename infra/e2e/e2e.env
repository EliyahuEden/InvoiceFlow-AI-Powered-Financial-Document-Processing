# Settings for the throwaway end-to-end stack (docker-compose.e2e.yml). Passing this file with --env-file means
# Compose never reads your .env: no real email provider, no paid AI, no production secrets. Safe to commit.
LLM_PROVIDER=offline
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMAIL_BACKEND=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=InvoiceFlow <no-reply@invoiceflow.local>
APP_BASE_URL=http://localhost:3001
RERANKER_BACKEND=none
RATE_LIMIT_LOGIN_PER_MINUTE=300
RATE_LIMIT_SIGNUP_PER_HOUR=1000
ENVIRONMENT=development
