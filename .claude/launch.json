{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--port", "8010", "--reload", "--reload-dir", "backend/app", "--timeout-graceful-shutdown", "3"],
      "port": 8010,
      "autoPort": false
    },
    {
      "name": "worker",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-c", "import sys; sys.path.insert(0, 'backend'); from app.worker import main; main()"],
      "port": 8011
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "env": { "BACKEND_URL": "http://localhost:8010" },
      "port": 3000
    }
  ]
}
